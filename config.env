# Shared configuration - sourced by every script
export PROJECT_ID="YOUR_PROJECT_ID"   # <-- change this to your GCP project ID
export REGION="asia-south1"            # Mumbai - closest to Pune; Dataflow + BigQuery both supported
export TOPIC="events-topic"
export SUBSCRIPTION="events-sub"
export DATASET="streaming_demo"
export BUCKET="${PROJECT_ID}-dataflow"  # temp/staging bucket for Dataflow
export SA_NAME="dataflow-streaming-sa"
export SA_EMAIL="${SA_NAME}@${PROJECT_ID}.iam.gserviceaccount.com"
export JOB_NAME="events-streaming-pipeline"
